{
  "name": "authentik-mcp",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "tsx scripts/generate-types.ts",
    "test:integration": "docker compose -f docker-compose.test.yml up -d && vitest run --config vitest.integration.config.ts",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "docs:tools": "tsx --tsconfig tsconfig.json scripts/tools-table.ts",
    "verify:permissions": "tsx --tsconfig tsconfig.json scripts/verify-permissions.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "isomorphic-dompurify": "4.6.0",
    "jose": "6.2.13",
    "mcp-handler": "2.3.0",
    "next": "16.4.2",
    "postcss": "8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "msw": "^3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0"
}
